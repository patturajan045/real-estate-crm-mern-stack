# Backend Environment Configuration
# Node environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Render automatically sets this, defaults to 5000 or 10000)
PORT=10000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/real_estate_crm?retryWrites=true&w=majority

# JWT Secret Key for signing authentication tokens
# Use a strong random key (Render Blueprints can auto-generate this)
JWT_SECRET_KEY=estateflow_live_jwt_secret_change_in_production_2026

# Allowed Frontend URLs for CORS
# Enter your live Vercel domain (e.g., https://your-app.vercel.app)
# Multiple origins can be comma-separated. *.vercel.app preview domains are allowed automatically.
CLIENT_URL=https://your-crm-frontend.vercel.app
